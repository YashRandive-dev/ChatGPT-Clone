# ---------- Server ----------
PORT=5000
NODE_ENV=development
# Public URL of the frontend (used for CORS + links in emails). Comma-separate multiple origins.
FRONTEND_URL=http://localhost:3000
# Proxies in front of the API (for real client IPs in rate limiting): empty = auto (1 on Render, 0 locally); 2 for Vercel -> Render
TRUST_PROXY=

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/kairo

# ---------- Auth ----------
# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Optional cookie domain (leave blank for host-only cookies)
COOKIE_DOMAIN=
# Comma-separated emails that are promoted to admin on registration
ADMIN_EMAILS=
# If true, users must verify their email before they can chat
REQUIRE_EMAIL_VERIFICATION=false

# ---------- AI provider ----------
OPENAI_API_KEY=
# Optional: custom base URL for OpenAI-compatible gateways
OPENAI_BASE_URL=
# Initial model catalog, seeded into AppSettings on first boot.
# Format: id|Label|vision(true/false)  separated by commas. Manage later in the admin dashboard.
AI_MODELS=gpt-4o-mini|GPT-4o mini|true,gpt-4o|GPT-4o|true
AI_DEFAULT_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=60000
AI_MAX_RETRIES=2

# ---------- Email (SMTP) ----------
# If SMTP_HOST is empty, emails are printed to the server console (development only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Kairo <no-reply@kairo.local>"

# ---------- Files ----------
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=10
